#!/bin/sh
# np-site: the only part of the platform that runs as root. The platform
# (user nordpress) may run it through sudo and nothing else; it checks every
# name it's given. Installed to /usr/local/sbin/np-site.
#
#   np-site create <name>    make the site's user and folder; its settings come on stdin
#   np-site start|stop|restart|status <name>
#   np-site update <name>    stop the site and give it the current build
#   np-site remove <name>    stop the site and delete its folder, settings and user
#   np-site env <name>       replace the site's settings with stdin
#   np-site template         download the build for the checked-out version
#   np-site domain-add <domain> [www]   serve a site's own domain, with a certificate
#   np-site domain-remove <domain>
set -eu

APP=/opt/nordpress
TEMPLATE=/var/lib/nordpress/template
SITES=/var/lib/nordpress/sites
SETTINGS=/etc/nordpress/sites
RELEASE=https://github.com/aleksandarsest/nordpress/releases/download/platform-build
NGINX=/etc/nginx/sites-enabled
PLATFORM_PORT=3100

fail() { echo "np-site: $*" >&2; exit 1; }

action=${1:-}
name=${2:-}

check_domain() {
  printf '%s' "$1" | grep -Eqx '([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z][a-z0-9-]{0,62}' &&
    [ ${#1} -le 253 ] || fail "not a domain: '$1'"
  # Never the platform's own domain, nor a name another app on this server serves
  platform=$(sed -n 's/^PLATFORM_DOMAIN=//p' /etc/nordpress/platform.env 2>/dev/null)
  case "$1" in
    "$platform" | *".$platform") fail "$1 belongs to the platform" ;;
  esac
  if grep -rlE "server_name[^;]*[[:space:]](www\.)?$(printf '%s' "$1" | sed 's/\./\\./g')[[:space:];]" "$NGINX" 2>/dev/null |
    grep -qv "/nordpress-domain-$1.conf$"; then
    fail "another site on this server already uses $1"
  fi
}

if [ "$action" = domain-add ] || [ "$action" = domain-remove ]; then
  check_domain "$name"
elif [ "$action" != template ]; then
  case "$name" in
    "" | -* | *-  | *[!a-z0-9-]*) fail "not a site name: '$name'" ;;
  esac
  [ ${#name} -ge 3 ] && [ ${#name} -le 29 ] || fail "not a site name: '$name'"
fi

user="np-$name"
dir="$SITES/$name"
unit="nordpress-site@$name.service"

# Each site gets its own copy of the build: Next.js writes regenerated pages into it
copy_build() {
  [ -f "$TEMPLATE/.next/BUILD_ID" ] || fail "no build yet; run: np-site template"
  rm -rf "$dir/.next"
  cp -a "$TEMPLATE/.next" "$dir/.next"
  chown -R "$user:$user" "$dir/.next"
}

case "$action" in
  create)
    id "$user" >/dev/null 2>&1 ||
      useradd --system --no-create-home --home-dir "$dir" --shell /usr/sbin/nologin "$user"
    mkdir -p "$dir/storage"
    for f in node_modules package.json next.config.ts public scripts src; do
      ln -sfn "$APP/$f" "$dir/$f"
    done
    copy_build
    chown "$user:$user" "$dir" "$dir/storage"
    chmod 700 "$dir"
    mkdir -p "$SETTINGS"
    chmod 700 "$SETTINGS"
    (umask 077 && cat > "$SETTINGS/$name.env")
    ;;
  start | stop | restart)
    systemctl "$action" "$unit"
    ;;
  status)
    systemctl is-active "$unit" || true
    ;;
  update)
    systemctl stop "$unit"
    copy_build
    ;;
  env)
    [ -d "$dir" ] || fail "no site called $name"
    (umask 077 && cat > "$SETTINGS/$name.env.new" && mv "$SETTINGS/$name.env.new" "$SETTINGS/$name.env")
    ;;
  domain-add)
    conf="$NGINX/nordpress-domain-$name.conf"
    names="$name"
    certnames="-d $name"
    if [ "${3:-}" = www ]; then
      names="$name www.$name"
      certnames="$certnames -d www.$name"
    fi
    if [ ! -f "$conf" ]; then
      cat > "$conf" <<NGINXCONF
# A Nordpress site's own domain (np-site domain-add); certbot adds HTTPS
server {
  listen 80;
  listen [::]:80;
  server_name $names;
  client_max_body_size 50m;
  location / {
    proxy_pass http://127.0.0.1:$PLATFORM_PORT;
    proxy_http_version 1.1;
    proxy_set_header Host \$host;
    proxy_set_header X-Forwarded-For \$remote_addr;
    proxy_set_header X-Forwarded-Proto \$scheme;
    proxy_read_timeout 300s;
    proxy_buffering off;
  }
}
NGINXCONF
      if ! nginx -t >/dev/null 2>&1; then
        rm -f "$conf"
        fail "nginx didn't accept the settings for $name"
      fi
      systemctl reload nginx
    fi
    # shellcheck disable=SC2086
    if ! certbot --nginx --non-interactive --agree-tos --redirect --keep-until-expiring \
      --cert-name "nordpress-$name" $certnames >/tmp/np-certbot.log 2>&1; then
      tail -5 /tmp/np-certbot.log >&2
      rm -f "$conf"
      systemctl reload nginx
      fail "couldn't get a certificate for $name"
    fi
    systemctl reload nginx
    ;;
  domain-remove)
    certbot delete --non-interactive --cert-name "nordpress-$name" >/dev/null 2>&1 || true
    rm -f "$NGINX/nordpress-domain-$name.conf"
    nginx -t >/dev/null 2>&1 && systemctl reload nginx
    ;;
  remove)
    systemctl stop "$unit" 2>/dev/null || true
    systemctl reset-failed "$unit" 2>/dev/null || true
    rm -rf "$dir"
    rm -f "$SETTINGS/$name.env"
    if id "$user" >/dev/null 2>&1; then userdel "$user"; fi
    ;;
  template)
    want=$(git -C "$APP" rev-parse HEAD)
    built=$(curl -fsSL "$RELEASE/nordpress-build.sha") || fail "couldn't reach the build on GitHub"
    [ "$built" = "$want" ] ||
      fail "GitHub has the build for $built, but $APP is at $want. Wait for the Platform build workflow, or check out $built."
    rm -rf "$TEMPLATE.new"
    mkdir -p "$TEMPLATE.new"
    curl -fsSL "$RELEASE/nordpress-build.tar.gz" | tar -xz -C "$TEMPLATE.new"
    [ -f "$TEMPLATE.new/.next/BUILD_ID" ] || fail "the download isn't a build"
    rm -rf "$TEMPLATE.old"
    if [ -d "$TEMPLATE" ]; then mv "$TEMPLATE" "$TEMPLATE.old"; fi
    mv "$TEMPLATE.new" "$TEMPLATE"
    rm -rf "$TEMPLATE.old"
    echo "Build $want is ready."
    ;;
  *)
    fail "usage: np-site create|start|stop|restart|status|update|remove|env <name>, np-site template, or np-site domain-add|domain-remove <domain> [www]"
    ;;
esac
