# Copy to /etc/nordpress/platform.env on the server (chmod 600) and fill in.
# Never commit the real one.
PLATFORM_DOMAIN=aleksa.me
PORT=3100
# openssl rand -base64 32
PLATFORM_SECRET=
# The platform's own database, and a role that may create each site's
PLATFORM_DATABASE_URL=postgres://nordpress_platform:PASSWORD@127.0.0.1:5432/nordpress_platform
ADMIN_DATABASE_URL=postgres://nordpress_admin:PASSWORD@127.0.0.1:5432/postgres
# Beta limits: sites in all, and sites running at once (the rest sleep)
MAX_SITES=10
MAX_AWAKE=2
IDLE_MINUTES=15
SITE_HEAP_MB=160
# The server's public IPv4 (and IPv6, if it has one), which people point
# their own domains at. Own domains are off while PUBLIC_IP is empty.
PUBLIC_IP=
PUBLIC_IP6=
# Names already used on this domain by other apps, comma-separated
RESERVED_SUBDOMAINS=
# Optional: email for the sites (password resets, forms, newsletters)
SMTP_URL=
MAIL_FROM=
