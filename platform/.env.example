# Copy to platform/.env on the server and fill in. Never commit the real one.
PLATFORM_DOMAIN=aleksa.me
# openssl rand -base64 32
PLATFORM_SECRET=
# openssl rand -hex 24
DB_PASSWORD=
NORDPRESS_IMAGE=nordpress:latest
MAX_SITES=10
SITE_MEMORY_MB=450
# Names already used on this domain by other apps, comma-separated
RESERVED_SUBDOMAINS=
# Optional: email for the sites (password resets, forms, newsletters)
SMTP_URL=
MAIL_FROM=
