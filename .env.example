DATABASE_URL=postgres://user:password@localhost:5432/nordpress
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Media storage: "local" (files on disk) or "s3" (AWS S3 or any S3-compatible
# service such as Cloudflare R2, Backblaze B2, DigitalOcean Spaces or MinIO).
# Either way, files are served at /uploads/... so URLs never change.
STORAGE_DRIVER=local
# local driver
UPLOADS_DIR=./storage/uploads
# s3 driver (S3_ENDPOINT only for non-AWS services; credentials fall back to
# the standard AWS chain when unset)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=uploads/
# Public URL of the site, used in feeds and sitemaps
SITE_URL=http://localhost:3000

# Claude API key for AI features (or use `ant auth login`)
ANTHROPIC_API_KEY=

# Voyage AI key for semantic search and site chat (https://www.voyageai.com)
VOYAGE_API_KEY=

# Outgoing email (password resets). Any SMTP provider works, e.g.
# smtps://user:password@smtp.postmarkapp.com:465. Unset: emails go to the log.
SMTP_URL=
MAIL_FROM="My Site <hello@example.com>"

# Rate limits are stored in Postgres so all server instances share them.
# Set to "memory" for a single server without the extra database writes.
RATE_LIMIT_STORE=postgres

# Optional: lets a scheduler run the daily Inbox checks at
# GET /api/cron/site-checks with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Optional: card payments in the shop through Stripe Checkout. Add a webhook
# for /api/shop/stripe in the Stripe dashboard and copy its signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
