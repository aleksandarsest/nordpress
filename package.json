{
  "name": "nordpress",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source WordPress alternative in TypeScript: a CMS on Node.js, Next.js and PostgreSQL with WordPress's concepts, REST API and importer, and Claude built in.",
  "keywords": [
    "wordpress",
    "wordpress-alternative",
    "wordpress-migration",
    "cms",
    "typescript",
    "nodejs",
    "nextjs",
    "postgresql",
    "blog",
    "headless-cms",
    "mcp",
    "claude"
  ],
  "homepage": "https://github.com/aleksandarsest/nordpress#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleksandarsest/nordpress.git"
  },
  "bugs": "https://github.com/aleksandarsest/nordpress/issues",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "dev:embedded": "node scripts/embedded-db.mjs sh -c \"node scripts/migrate.mjs && next dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "migrate": "node scripts/migrate.mjs",
    "new:plugin": "node scripts/new-plugin.mjs",
    "new:theme": "node scripts/new-theme.mjs",
    "port:wp": "node scripts/port-wp.mjs",
    "db:studio": "drizzle-kit studio",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "3.1157.0",
    "@base-ui/react": "^1.9.0",
    "@better-auth/passkey": "1.7.13",
    "@electric-sql/pglite": "0.5.9",
    "@electric-sql/pglite-pgvector": "0.0.10",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/html": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "better-auth": "^1.7.13",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "5.11.2",
    "happy-dom": "20.14.6",
    "image-size": "^2.0.4",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.2",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "nodemailer": "10.2.1",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "uqr": "0.1.3",
    "voyageai": "0.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "0.31.11",
    "shadcn": "4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "type": "module"
}
